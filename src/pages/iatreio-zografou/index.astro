---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout
  title={"Παιδίατρος Ζωγράφου | Ιατρείο Μάριου Δέτση"}
  description={"Παιδιατρικό ιατρείο στη Ζωγράφου (Ευδήλου 9–11, Πλ. Ελευθερίας). Επισκέψεις κατόπιν ραντεβού. Τηλ. 210 300 7410."}
  nav={"/iatreia/"}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "MedicalClinic",
      "name": "Μάριος Δέτσης, Παιδίατρος — Ιατρείο Ζωγράφου",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Ευδήλου 9–11, Πλ. Ελευθερίας, Ζωγράφου",
        "addressLocality": "Ζωγράφου",
        "addressCountry": "GR"
      },
      "telephone": "+302103007410",
      "url": "https://detsis-paidiatros.gr/iatreio-zografou/",
      "email": "grammateia@detsis-paidiatros.gr",
      "medicalSpecialty": "Pediatric"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Αρχική",
          "item": "https://detsis-paidiatros.gr/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Ιατρεία",
          "item": "https://detsis-paidiatros.gr/iatreia/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Ιατρείο Ζωγράφου",
          "item": "https://detsis-paidiatros.gr/iatreio-zografou/"
        }
      ]
    }
  ]}
>

  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Διαδρομή"><ol><li><a href="/">Αρχική</a></li><li><a href="/iatreia/">Ιατρεία</a></li><li aria-current="page">Ιατρείο Ζωγράφου</li></ol></nav>
      <h1>Ιατρείο Ζωγράφου</h1>
      <p class="page-hero-sub">Στο ιατρείο Ζωγράφου, στην Ευδήλου 9–11 στην Πλατεία Ελευθερίας, οι γονείς μπορούν να προγραμματίσουν παιδιατρική εξέταση και παρακολούθηση. Ο χώρος διαθέτει φιλόξενο χώρο αναμονής και παιδική γωνιά, ώστε η επίσκεψη να γίνεται πιο ήρεμα για το παιδί.</p>
      <div class="hero-cta">
        <a class="btn btn-accent btn-lg" href="/rantevou/">Κλείστε Ραντεβού</a>
        <a class="btn btn-ghost btn-lg" href="tel:+302103007410">Καλέστε τώρα</a>
      </div>
    </div>
  </section>

  <section class="bio">
    <div class="wrap bio-split">
      <div class="info-card">
        <h3>Στοιχεία ιατρείου</h3>
        <div class="info-rows">
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><div class="v"><span class="k">Διεύθυνση</span>Ευδήλου 9–11, Πλ. Ελευθερίας, Ζωγράφου</div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><div class="v"><span class="k">Τηλέφωνο</span><a href="tel:+302103007410">210 300 7410</a></div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div class="v"><span class="k">Ωράριο</span>Κατόπιν ραντεβού</div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><div class="v"><span class="k">Email</span><a href="mailto:grammateia@detsis-paidiatros.gr">grammateia@detsis-paidiatros.gr</a><br><a href="mailto:paidiatros@detsis-paidiatros.gr">paidiatros@detsis-paidiatros.gr</a></div></div>
        </div>
        <div class="info-actions">
          <a class="btn btn-accent" href="/rantevou/">Φόρμα ραντεβού</a>
          <a class="btn btn-outline" href="https://www.google.com/maps/search/?api=1&query=Ευδήλου+9-11,+Πλατεία+Ελευθερίας,+Ζωγράφου" target="_blank" rel="noopener">Άνοιγμα στους Χάρτες</a>
        </div>
      </div>
      <div class="map-embed" data-map data-src="https://www.google.com/maps?q=Ευδήλου+9-11,+Πλατεία+Ελευθερίας,+Ζωγράφου&output=embed">
        <button class="map-load" type="button"><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 6 2 5-2v14l-5 2-6-2-5 2V6z"/><path d="M9 4v14M15 6v14"/></svg>Προβολή χάρτη<small>Φόρτωση από Google Maps</small></button>
      </div>
    </div>
  </section>

  <section class="clinics">
    <div class="wrap">
      <header class="section-head" data-rise>
        <h2 class="section-title">Ο χώρος του ιατρείου</h2>
        <p class="section-sub">Φιλόξενοι και λειτουργικοί χώροι αναμονής για γονείς και παιδιά.</p>
      </header>
      <ul class="clinic-gallery clinic-gallery--photos clinic-gallery--wide-last" data-stagger>
        <li><figure><img src="/assets/img/clinics/zografou/exam-room-aquarium-1200.webp" srcset="/assets/img/clinics/zografou/exam-room-aquarium-600.webp 600w, /assets/img/clinics/zografou/exam-room-aquarium-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Εξεταστήριο με εξεταστικό κρεβάτι, ζυγαριά βρεφών και ενυδρείο" width="1200" height="800" loading="lazy"><figcaption>Εξεταστήριο</figcaption></figure></li>
        <li class="is-tall"><figure><img src="/assets/img/clinics/zografou/teepee-900.webp" srcset="/assets/img/clinics/zografou/teepee-450.webp 450w, /assets/img/clinics/zografou/teepee-900.webp 900w" sizes="(max-width: 920px) 50vw, 400px" alt="Παιδική σκηνή και κούνια σε χώρο του ιατρείου" width="900" height="1200" loading="lazy"><figcaption>Παιδική σκηνή</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/zografou/desk-exam-bed-1200.webp" srcset="/assets/img/clinics/zografou/desk-exam-bed-600.webp 600w, /assets/img/clinics/zografou/desk-exam-bed-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Γραφείο ιατρού με υπολογιστή, ράφια και εξεταστικό κρεβάτι" width="1200" height="800" loading="lazy"><figcaption>Γραφείο ιατρού</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/zografou/waiting-room-wide-1200.webp" srcset="/assets/img/clinics/zografou/waiting-room-wide-600.webp 600w, /assets/img/clinics/zografou/waiting-room-wide-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Χώρος με παιδικό τραπεζάκι, παιχνίδια, σκηνή και κούνια" width="1200" height="800" loading="lazy"><figcaption>Παιδική γωνιά</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/zografou/teepee-sofa-1200.webp" srcset="/assets/img/clinics/zografou/teepee-sofa-600.webp 600w, /assets/img/clinics/zografou/teepee-sofa-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Παιδική σκηνή, κούνια και λευκός γωνιακός καναπές" width="1200" height="800" loading="lazy"><figcaption>Χώρος αναμονής</figcaption></figure></li>
        <li class="is-tall"><figure><img src="/assets/img/clinics/zografou/doctor-two-children-900.webp" srcset="/assets/img/clinics/zografou/doctor-two-children-450.webp 450w, /assets/img/clinics/zografou/doctor-two-children-900.webp 900w" sizes="(max-width: 920px) 50vw, 400px" alt="Ο ιατρός εξετάζει ένα παιδί στο εξεταστικό κρεβάτι, με ένα δεύτερο παιδί δίπλα" width="900" height="1200" loading="lazy"><figcaption>Στο εξεταστήριο</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/zografou/teal-sofa-room-1200.webp" srcset="/assets/img/clinics/zografou/teal-sofa-room-600.webp 600w, /assets/img/clinics/zografou/teal-sofa-room-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Δωμάτιο με τιρκουάζ καναπέ, λούτρινα και ξύλινο αλογάκι" width="1200" height="800" loading="lazy"><figcaption>Χώρος παιχνιδιού</figcaption></figure></li>
        <li class="is-tall"><figure><img src="/assets/img/clinics/zografou/desk-caricature-900.webp" srcset="/assets/img/clinics/zografou/desk-caricature-450.webp 450w, /assets/img/clinics/zografou/desk-caricature-900.webp 900w" sizes="(max-width: 920px) 50vw, 400px" alt="Καρικατούρα του ιατρού σε κορνίζα πάνω στο γραφείο, δίπλα σε μολυβοθήκη" width="900" height="1200" loading="lazy"><figcaption>Γραφείο ιατρού</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/zografou/sofa-swing-1200.webp" srcset="/assets/img/clinics/zografou/sofa-swing-600.webp 600w, /assets/img/clinics/zografou/sofa-swing-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Λευκός καναπές, κρεμαστή κούνια και πολυθρόνα θηλασμού" width="1200" height="800" loading="lazy"><figcaption>Κούνια</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/zografou/sofa-doors-1200.webp" srcset="/assets/img/clinics/zografou/sofa-doors-600.webp 600w, /assets/img/clinics/zografou/sofa-doors-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Λευκός καναπές, κούνια και τζαμόπορτες στον χώρο αναμονής" width="1200" height="800" loading="lazy"><figcaption>Χώρος αναμονής</figcaption></figure></li>
      </ul>
      <div class="section-foot" data-rise>
        <a class="link-arrow" href="/iatreio-vrilission/">Δείτε και το Ιατρείο Βριλησσίων</a>
      </div>
    </div>
  </section>

  <CtaBand title={"Κλείστε ραντεβού με τον ιατρό."} text={"Στείλτε αίτημα ηλεκτρονικά ή καλέστε απευθείας το ιατρείο που σας εξυπηρετεί."} />
</BaseLayout>
