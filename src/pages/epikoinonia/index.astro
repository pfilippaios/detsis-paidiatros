---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title={"Επικοινωνία | Μάριος Δέτσης, Παιδίατρος"}
  description={"Στοιχεία επικοινωνίας για τα παιδιατρικά ιατρεία Ζωγράφου και Βριλησσίων: διευθύνσεις, τηλέφωνα και email. Επισκέψεις κατόπιν ραντεβού."}
  nav={"/epikoinonia/"}
>

  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Διαδρομή"><ol><li><a href="/">Αρχική</a></li><li aria-current="page">Επικοινωνία</li></ol></nav>
      <h1>Επικοινωνία</h1>
      <p class="page-hero-sub">Ο δρ Μάριος Δέτσης δέχεται στα ιατρεία Ζωγράφου και Βριλησσίων. Για ραντεβού μπορείτε να επικοινωνείτε τηλεφωνικά ή μέσω email.</p>
    </div>
  </section>

  <section class="bio">
    <div class="wrap">
      <div class="clinic-grid" data-stagger style="align-items:start">
      <div class="info-card">
        <h3>Ιατρείο Ζωγράφου</h3>
        <div class="info-rows">
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><div class="v"><span class="k">Διεύθυνση</span>Ευδήλου 9–11, Πλ. Ελευθερίας, Ζωγράφου</div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><div class="v"><span class="k">Τηλέφωνα</span><a href="tel:+302103007410">210 300 7410</a><br><a href="tel:+306937000410">693 7000 410</a></div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div class="v"><span class="k">Ωράριο</span>Κατόπιν ραντεβού</div></div>
        </div>
        <div class="info-actions">
          <a class="btn btn-outline" href="https://www.google.com/maps/search/?api=1&query=Ευδήλου+9-11,+Πλατεία+Ελευθερίας,+Ζωγράφου" target="_blank" rel="noopener">Άνοιγμα στους Χάρτες</a>
        </div>
      </div>
      <div class="info-card">
        <h3>Ιατρείο Βριλησσίων</h3>
        <div class="info-rows">
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><div class="v"><span class="k">Διεύθυνση</span>Γράμμου 23, Βριλήσσια</div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><div class="v"><span class="k">Τηλέφωνα</span><a href="tel:+302103007410">210 300 7410</a><br><a href="tel:+306937000410">693 7000 410</a></div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div class="v"><span class="k">Ωράριο</span>Κατόπιν ραντεβού</div></div>
        </div>
        <div class="info-actions">
          <a class="btn btn-outline" href="https://www.google.com/maps/search/?api=1&query=Γράμμου+23,+Βριλήσσια" target="_blank" rel="noopener">Άνοιγμα στους Χάρτες</a>
        </div>
      </div>
      </div>
      <div class="info-card" style="margin-top:var(--sp-4)">
        <h3>Email &amp; κοινωνικά δίκτυα</h3>
        <div class="info-rows">
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><div class="v"><span class="k">Ραντεβού / γραμματεία</span><a href="mailto:grammateia@detsis-paidiatros.gr">grammateia@detsis-paidiatros.gr</a></div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><div class="v"><span class="k">Επικοινωνία με τον ιατρό</span><a href="mailto:paidiatros@detsis-paidiatros.gr">paidiatros@detsis-paidiatros.gr</a></div></div>
        </div>
        <div class="info-actions">
          <a class="btn btn-accent" href="/rantevou/">Φόρμα ραντεβού</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
