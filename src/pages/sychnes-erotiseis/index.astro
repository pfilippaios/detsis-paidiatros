---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout
  title={"Συχνές Ερωτήσεις | Παιδίατρος Μάριος Δέτσης"}
  description={"Απαντήσεις σε συχνές ερωτήσεις γονέων: πότε να καλέσετε τον παιδίατρο, εμβολιασμοί, ιώσεις, ύπνος, θηλασμός, αλλεργίες και αφυδάτωση."}
  nav={"/sychnes-erotiseis/"}
>

  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Διαδρομή"><ol><li><a href="/">Αρχική</a></li><li aria-current="page">Συχνές Ερωτήσεις</li></ol></nav>
      <h1>Συχνές Ερωτήσεις</h1>
      <p class="page-hero-sub">Σύντομες, ενημερωτικές απαντήσεις σε συχνά ερωτήματα. Δεν αντικαθιστούν την ιατρική εξέταση· σε κάθε αμφιβολία επικοινωνήστε με το ιατρείο.</p>
    </div>
  </section>

  <section class="bio">
    <div class="wrap">
      <div class="faq-list">
        <h2 class="faq-group-title">Θηλασμός</h2>
        <details class="faq-item">
          <summary>Πρέπει να το ξυπνάω για να φάει;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Πόσο γάλα πρέπει να πίνει;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Πώς ξέρω ότι χορταίνει;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <h2 class="faq-group-title">Ύπνος</h2>
        <details class="faq-item">
          <summary>Πόση ώρα πρέπει να κοιμάται;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Κάθε μία ώρα ξυπνάει, τι να κάνω;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Να το βάλω μπρούμυτα;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Να κοιμηθεί μαζί μας στο κρεβάτι;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Πρέπει να έχει πρόγραμμα ύπνου;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <h2 class="faq-group-title">Άλλα θέματα του νεογνού</h2>
        <details class="faq-item">
          <summary>Φτερνίζεται συχνά. Είναι κρυωμένο;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Πώς περνάει ο λόξιγκας;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <h2 class="faq-group-title">Μεγαλύτερα βρέφη</h2>
        <details class="faq-item">
          <summary>Ποια είναι η καλύτερη formula για το μωρό μου;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Να δώσω νερό / χαμομήλι πριν τους 6 μήνες;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Πότε θα ξεκινήσει τις στερεές τροφές;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Μέχρι πότε να θηλάσω;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Το παιδί μου δεν τρώει.</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Με τι θερμόμετρο να μετρήσω και πώς;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
        <details class="faq-item">
          <summary>Πότε δίνω αντιπυρετικό και πόσο;</summary>
          <div class="faq-answer"><p class="faq-pending">Η απάντηση θα προστεθεί σύντομα.</p></div>
        </details>
      </div>
    </div>
  </section>

  <CtaBand title={"Κλείστε ραντεβού με τον ιατρό."} text={"Στείλτε αίτημα ηλεκτρονικά ή καλέστε απευθείας το ιατρείο που σας εξυπηρετεί."} />
</BaseLayout>
