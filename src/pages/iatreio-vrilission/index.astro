---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout
  title={"Παιδίατρος Βριλήσσια | Ιατρείο Μάριου Δέτση"}
  description={"Παιδιατρικό ιατρείο στα Βριλήσσια (Γράμμου 23). Επισκέψεις κατόπιν ραντεβού. Τηλ. 210 300 7410."}
  nav={"/iatreia/"}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "MedicalClinic",
      "name": "Μάριος Δέτσης, Παιδίατρος — Ιατρείο Βριλησσίων",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Γράμμου 23, Βριλήσσια",
        "addressLocality": "Βριλήσσια",
        "addressCountry": "GR"
      },
      "telephone": "+302103007410",
      "url": "https://detsis-paidiatros.gr/iatreio-vrilission/",
      "email": "grammateia@detsis-paidiatros.gr",
      "medicalSpecialty": "Pediatric"
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Αρχική",
          "item": "https://detsis-paidiatros.gr/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Ιατρεία",
          "item": "https://detsis-paidiatros.gr/iatreia/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Ιατρείο Βριλησσίων",
          "item": "https://detsis-paidiatros.gr/iatreio-vrilission/"
        }
      ]
    }
  ]}
>

  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Διαδρομή"><ol><li><a href="/">Αρχική</a></li><li><a href="/iatreia/">Ιατρεία</a></li><li aria-current="page">Ιατρείο Βριλησσίων</li></ol></nav>
      <h1>Ιατρείο Βριλησσίων</h1>
      <p class="page-hero-sub">Στο ιατρείο Βριλησσίων, στη Γράμμου 23, παρέχεται παιδιατρική φροντίδα για βρέφη, παιδιά και εφήβους. Ο χώρος αναμονής είναι φιλόξενος και υπάρχει παιδική γωνιά, ώστε οι οικογένειες να αισθάνονται πιο άνετα πριν την εξέταση.</p>
      <div class="hero-cta">
        <a class="btn btn-accent btn-lg" href="/rantevou/">Κλείστε Ραντεβού</a>
        <a class="btn btn-ghost btn-lg" href="tel:+302103007410">Καλέστε τώρα</a>
      </div>
    </div>
  </section>

  <section class="bio">
    <div class="wrap bio-split">
      <div class="info-card">
        <h3>Στοιχεία ιατρείου</h3>
        <div class="info-rows">
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><div class="v"><span class="k">Διεύθυνση</span>Γράμμου 23, Βριλήσσια</div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg><div class="v"><span class="k">Τηλέφωνο</span><a href="tel:+302103007410">210 300 7410</a></div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div class="v"><span class="k">Ωράριο</span>Κατόπιν ραντεβού</div></div>
          <div><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><div class="v"><span class="k">Email</span><a href="mailto:grammateia@detsis-paidiatros.gr">grammateia@detsis-paidiatros.gr</a><br><a href="mailto:paidiatros@detsis-paidiatros.gr">paidiatros@detsis-paidiatros.gr</a></div></div>
        </div>
        <div class="info-actions">
          <a class="btn btn-accent" href="/rantevou/">Φόρμα ραντεβού</a>
          <a class="btn btn-outline" href="https://www.google.com/maps/search/?api=1&query=Γράμμου+23,+Βριλήσσια" target="_blank" rel="noopener">Άνοιγμα στους Χάρτες</a>
        </div>
      </div>
      <div class="map-embed" data-map data-src="https://www.google.com/maps?q=Γράμμου+23,+Βριλήσσια&output=embed">
        <button class="map-load" type="button"><svg class="icn" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 4 6 2 5-2v14l-5 2-6-2-5 2V6z"/><path d="M9 4v14M15 6v14"/></svg>Προβολή χάρτη<small>Φόρτωση από Google Maps</small></button>
      </div>
    </div>
  </section>

  <section class="clinics">
    <div class="wrap">
      <header class="section-head" data-rise>
        <h2 class="section-title">Ο χώρος του ιατρείου</h2>
        <p class="section-sub">Φιλόξενοι και λειτουργικοί χώροι αναμονής για γονείς και παιδιά.</p>
      </header>
      <ul class="clinic-gallery clinic-gallery--photos" data-stagger>
        <li class="is-tall"><figure><img src="/assets/img/clinics/vrilissia/doctor-storefront-900.webp" srcset="/assets/img/clinics/vrilissia/doctor-storefront-450.webp 450w, /assets/img/clinics/vrilissia/doctor-storefront-900.webp 900w" sizes="(max-width: 920px) 50vw, 400px" alt="Ο ιατρός Μάριος Δέτσης μπροστά στη βιτρίνα του ιατρείου στα Βριλήσσια" width="900" height="1200" loading="lazy"><figcaption>Είσοδος ιατρείου</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/vrilissia/exam-room-desk-1200.webp" srcset="/assets/img/clinics/vrilissia/exam-room-desk-600.webp 600w, /assets/img/clinics/vrilissia/exam-room-desk-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Εξεταστήριο με εξεταστικό κρεβάτι, ντουλάπια και γραφείο με φορητό υπολογιστή" width="1200" height="800" loading="lazy"><figcaption>Εξεταστήριο</figcaption></figure></li>
        <li class="is-tall"><figure><img src="/assets/img/clinics/vrilissia/tiger-toy-900.webp" srcset="/assets/img/clinics/vrilissia/tiger-toy-450.webp 450w, /assets/img/clinics/vrilissia/tiger-toy-900.webp 900w" sizes="(max-width: 920px) 50vw, 400px" alt="Παιδικό παιχνίδι-περπατούρα σε σχήμα τίγρη δίπλα σε φυτό" width="900" height="1200" loading="lazy"><figcaption>Παιχνίδια</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/vrilissia/exam-room-1200.webp" srcset="/assets/img/clinics/vrilissia/exam-room-600.webp 600w, /assets/img/clinics/vrilissia/exam-room-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Εξεταστικό κρεβάτι και πάγκος με ιατρικά εργαλεία κάτω από ράφι με βιβλία" width="1200" height="800" loading="lazy"><figcaption>Εξεταστήριο</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/vrilissia/waiting-room-1200.webp" srcset="/assets/img/clinics/vrilissia/waiting-room-600.webp 600w, /assets/img/clinics/vrilissia/waiting-room-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Χώρος αναμονής με λευκό καναπέ, φυτά και παιδικά παιχνίδια" width="1200" height="800" loading="lazy"><figcaption>Χώρος αναμονής</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/vrilissia/play-corner-1200.webp" srcset="/assets/img/clinics/vrilissia/play-corner-600.webp 600w, /assets/img/clinics/vrilissia/play-corner-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Παιδική γωνιά με βιβλιοθήκη, παιχνίδια και καναπέ" width="1200" height="800" loading="lazy"><figcaption>Παιδική γωνιά</figcaption></figure></li>
        <li><figure><img src="/assets/img/clinics/vrilissia/bookshelf-1200.webp" srcset="/assets/img/clinics/vrilissia/bookshelf-600.webp 600w, /assets/img/clinics/vrilissia/bookshelf-1200.webp 1200w" sizes="(max-width: 920px) 50vw, 400px" alt="Κίτρινο ράφι με ιατρικά βιβλία, διακοσμητικό και παιδικό πίνακα" width="1200" height="800" loading="lazy"><figcaption>Βιβλιοθήκη</figcaption></figure></li>
      </ul>
      <div class="section-foot" data-rise>
        <a class="link-arrow" href="/iatreio-zografou/">Δείτε και το Ιατρείο Ζωγράφου</a>
      </div>
    </div>
  </section>

  <CtaBand title={"Κλείστε ραντεβού με τον ιατρό."} text={"Στείλτε αίτημα ηλεκτρονικά ή καλέστε απευθείας το ιατρείο που σας εξυπηρετεί."} />
</BaseLayout>
