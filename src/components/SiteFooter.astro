---
import { clinics, emails } from '../data/site';
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <img src="/assets/img/brand/detsis_logo.webp" alt="Μάριος Δέτσης, Παιδίατρος" width="195" height="64">
      <div class="footer-social">
        <a href="https://www.facebook.com/detsispaidiatros/" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg></a>
        <a href="https://www.instagram.com/mariosdetsis_paidiatros/" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor" stroke="none"/></svg></a>
      </div>
    </div>
    {clinics.map((clinic) => (
      <div class="footer-col">
        <h4>{clinic.name}</h4>
        <p>{clinic.address}</p>
        <p><a href="tel:+302103007410">210 300 7410</a></p>
      </div>
    ))}
    <div class="footer-col">
      <h4>Επικοινωνία</h4>
      <p>Κατόπιν ραντεβού</p>
      <p><a href={`mailto:${emails.office}`}>{emails.office}</a></p>
      <p><a href={`mailto:${emails.doctor}`}>{emails.doctor}</a></p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>© Μάριος Δέτσης, Παιδίατρος</p>
    <p><a href="/cookies-policy/">Πολιτική Cookies</a></p>
    <p><a href="#" aria-disabled="true">Πολιτική Απορρήτου</a></p>
    <p><a href="#" aria-disabled="true">Όροι Χρήσης Ιστοσελίδας</a></p>
    <p><a href="#" aria-disabled="true">Δήλωση Προσβασιμότητας</a></p>
  </div>
</footer>
