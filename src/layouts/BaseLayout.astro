---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/sections.css';
import '../styles/pages.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** og:description, when it should differ from the meta description */
  ogDescription?: string;
  /** share image, path under /public or absolute URL; defaults to the hero-style card */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** href of the top-level menu item to highlight */
  nav?: string;
  jsonLd?: object[];
  /** keep the page out of search results (404) */
  noindex?: boolean;
}

const { title, description, ogDescription = description, ogImage, ogType = 'website', nav, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareImage = new URL(ogImage ?? '/assets/img/og/og-default.jpg', Astro.site);
---
<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<link rel="icon" href="/assets/img/brand/favicon.png">
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<meta property="og:type" content={ogType}>
<meta property="og:locale" content="el_GR">
<meta property="og:url" content={canonical}>
<meta property="og:image" content={shareImage}>
{!ogImage && <><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"></>}
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="https://use.typekit.net/aix4wav.css">
{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
</head>
<body>
<a class="skip-link" href="#main">Μετάβαση στο περιεχόμενο</a>
<SiteHeader current={nav} />
<main id="main">
  <slot />
</main>
<SiteFooter />
<script>
  import '../scripts/main.js';
</script>
</body>
</html>
